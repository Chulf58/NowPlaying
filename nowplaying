def friendly_app_error(e):
    """What to tell the user when a request to the YouTube Music app failed."""
    if isinstance(e, TimeoutError) or isinstance(getattr(e, "reason", None), TimeoutError):
        return "YouTube Music is busy and didn't answer in time, try again in a moment"
