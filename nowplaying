class Api:
    """HTTP client for the YouTube Music app's API Server plugin."""

    def __init__(self):
        self.token = None
        try:
            with open(TOKEN_FILE) as f:
                self.token = f.read().strip() or None
        except OSError:
            pass

    def request(self, method, path, body=None, timeout=15, auth=True):
        """One API call. The app can stall for seconds (just after it starts, or while it's busy
        loading songs), so the timeout is generous and a timed-out read is retried once."""
        for attempt in range(2):
            try:
                return self._request(method, path, body, timeout, auth)
            except (TimeoutError, urllib.error.URLError) as e:
                timed_out = isinstance(e, TimeoutError) or isinstance(getattr(e, "reason", None), TimeoutError)
                if not timed_out or method != "GET" or attempt:
                    raise

    def _request(self, method, path, body, timeout, auth):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(f"http://{API_HOST}:{API_PORT}{path}", data=data, method=method)
        if data is not None:
            req.add_header("Content-Type", "application/json")
        if auth and self.token:
            req.add_header("Authorization", f"Bearer {self.token}")
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read()
                return json.loads(raw) if raw else None
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                raise AuthError() from e
            raise

    def authorize(self):
        """Ask the app for a token; the app shows an Allow/Deny dialog the first time."""
        res = self.request("POST", f"/auth/{CLIENT_ID}", timeout=300, auth=False)
        self.token = res["accessToken"]
        os.makedirs(CONF_DIR, exist_ok=True)
        fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(self.token)

    def forget_token(self):
        self.token = None
        try:
            os.remove(TOKEN_FILE)
        except OSError:
            pass

    def port_open(self):
        try:
            socket.create_connection((API_HOST, API_PORT), timeout=0.5).close()
            return True
        except OSError:
            return False

    def search(self, query):
        """Search through the app (used when ytmusicapi isn't available)."""
        res = self.request("POST", "/api/v1/search", {"query": query}, timeout=10)
        results, seen = [], set()
        for card in walk(res, "musicCardShelfRenderer"):  # the "top result" card
            vid = (find_key(card.get("title", {}), "watchEndpoint") or {}).get("videoId") \
                or (find_key(card, "watchEndpoint") or {}).get("videoId")
            if vid and vid not in seen:
                seen.add(vid)
                results.append({"videoId": vid, "title": runs_text(card.get("title")),
                                "subtitle": runs_text(card.get("subtitle"))})
        for item in walk(res, "musicResponsiveListItemRenderer"):
            vid = (item.get("playlistItemData") or {}).get("videoId") \
                or (find_key(item.get("overlay", {}), "watchEndpoint") or {}).get("videoId")
            if not vid or vid in seen:
                continue  # artists, albums and playlists have no videoId
            cols = [runs_text(c.get("musicResponsiveListItemFlexColumnRenderer", {}).get("text"))
                    for c in item.get("flexColumns", [])]
            seen.add(vid)
            results.append({"videoId": vid, "title": cols[0] if cols else "?",
                            "subtitle": " • ".join(c for c in cols[1:] if c)})
        return results

    def queue(self):
        """The app's queue. `index` is the position the API expects (unparseable items keep their slot)."""
        res = self.request("GET", "/api/v1/queue")
        items = []
        for idx, it in enumerate((res or {}).get("items", [])):
            r = queue_renderer(it)
            if not r:
                continue
            items.append({"index": idx, "title": runs_text(r.get("title")),
                          "artist": runs_text(r.get("shortBylineText")),
                          "length": runs_text(r.get("lengthText")),
                          "videoId": r.get("videoId"),
                          "current": bool(r.get("selected"))})
        return items

    def next_song(self):
        res = self.request("GET", "/api/v1/queue/next")
        if not res:
            return None
        return {"title": res.get("title") or "", "artist": runs_text(res.get("shortBylineText"))}


class WebSocket:
    """Just enough of a websocket client (RFC 6455) to read the app's live updates."""

    def __init__(self, host, port, path):
        self.sock = socket.create_connection((host, port), timeout=5)
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((f"GET {path} HTTP/1.1\r\nHost: {host}:{port}\r\n"
                           "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                           f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise ConnectionError("websocket handshake failed")
            buf += chunk
        head, self.buf = buf.split(b"\r\n\r\n", 1)
        status = head.split(b"\r\n")[0].split()
        code = int(status[1]) if len(status) > 1 and status[1].isdigit() else 0
        if code in (401, 403):
            self.sock.close()
            raise AuthError()
        if code != 101:
            self.sock.close()
            raise ConnectionError(f"websocket handshake refused ({code})")
        self.sock.settimeout(None)

    def _exact(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("websocket closed")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def send(self, opcode, payload=b""):
        mask, n = os.urandom(4), len(payload)
        head = bytes([0x80 | opcode])
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + n.to_bytes(2, "big")
        else:
            head += bytes([0x80 | 127]) + n.to_bytes(8, "big")
        self.sock.sendall(head + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def messages(self):
        """Yield text messages until the connection closes. Returns the close code."""
        parts = []
        while True:
            b0, b1 = self._exact(2)
            opcode, n = b0 & 0x0F, b1 & 0x7F
            if n == 126:
                n = int.from_bytes(self._exact(2), "big")
            elif n == 127:
                n = int.from_bytes(self._exact(8), "big")
            mask = self._exact(4) if b1 & 0x80 else None
            payload = self._exact(n)
            if mask:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            if opcode == 8:  # close
                return int.from_bytes(payload[:2], "big") if len(payload) >= 2 else None
            if opcode == 9:  # ping
                self.send(10, payload)
            elif opcode in (0, 1):
                parts.append(payload)
                if b0 & 0x80:
                    yield b"".join(parts).decode("utf-8", "replace")
                    parts = []

    def close(self):
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


