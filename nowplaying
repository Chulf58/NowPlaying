ESC = "\x1b["
RESET = ESC + "0m"


# ------------------------------------------------------------------- text & color

def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


@functools.lru_cache(maxsize=1024)
def fg(rgb, bold=False):
    if isinstance(rgb, str):
        rgb = hex_rgb(rgb)
    return f"{ESC}{'1;' if bold else ''}38;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


@functools.lru_cache(maxsize=256)
def bg(rgb):
    if isinstance(rgb, str):
        rgb = hex_rgb(rgb)
    return f"{ESC}48;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def blend(stops, t):
    """Colour at fraction t (0..1) along a sequence of hex stops."""
    t = min(max(t, 0.0), 1.0) * (len(stops) - 1)
    i = min(int(t), len(stops) - 2)
    a, b = hex_rgb(stops[i]), hex_rgb(stops[i + 1])
    f = t - i
    return tuple(round(a[k] + (b[k] - a[k]) * f) for k in range(3))


def dim(rgb, factor):
    return tuple(round(c * factor) for c in rgb)


@functools.lru_cache(maxsize=4096)
def char_cells(ch):
    """Terminal cells a character occupies: 0 for combining/format marks, 2 for wide (CJK, emoji)."""
    if unicodedata.combining(ch) or unicodedata.category(ch) in ("Mn", "Me", "Cf"):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


VS16 = "\ufe0f"  # variation selector 16: the preceding character is drawn as a 2-cell emoji


def cells(text):
    if text.isascii():
        return len(text)
    width = sum(map(char_cells, text))
    if VS16 in text:
        width += sum(1 for a, b in zip(text, text[1:]) if b == VS16 and char_cells(a) == 1)
    return width


CONTROL_CHARS = re.compile("[\x00-\x1f\x7f-\x9f\u2028\u2029\ud800-\udfff]")  # Cc, Zl, Zp, Cs


def sanitize(text):
    """Drop control characters from metadata so they can't move the cursor or break the layout."""
    return CONTROL_CHARS.sub("", str(text))


def fit(text, width, ellipsis=True):
    """Cut text to at most `width` terminal cells (wide characters count double)."""
    text = sanitize(text)
    if width <= 0:
        return ""
    if cells(text) <= width:
        return text
    limit = width - 1 if ellipsis else width
    out, used = [], 0
    for i, c in enumerate(text):
        w = char_cells(c)
        if w == 1 and text[i + 1:i + 2] == VS16:
            w = 2
        if used + w > limit:
            break
        out.append(c)
        used += w
    return "".join(out) + ("…" if ellipsis else " " * (width - used))


def pad(text, width):
    return text + " " * max(width - cells(text), 0)


@functools.lru_cache(maxsize=64)
def gradient_codes(length, stops, bold):
    n = max(length - 1, 1)
    return [fg(blend(stops, i / n), bold) for i in range(length)]


@functools.lru_cache(maxsize=512)
def gradient_text(text, stops, bold=True):
    return "".join(map(str.__add__, gradient_codes(len(text), stops, bold), text)) + RESET


@functools.lru_cache(maxsize=256)
def track_bar(track_w, done, knob):
    """The coloured part of the time bar (cached: it only changes when the knob moves)."""
    bar = "".join(fg(blend(TRACK_STOPS, i / max(track_w - 1, 1)))
                  + ("━" if i < done else knob if i == done else "─") for i in range(done + 1))
    return bar + fg("#3a2d55") + "─" * (track_w - done - 1)


def fmt_time(seconds):
    if seconds is None or seconds < 0:
        return "-:--"
    s = int(seconds)
    return f"{s // 3600}:{s // 60 % 60:02}:{s % 60:02}" if s >= 3600 else f"{s // 60}:{s % 60:02}"


def runs_text(obj):
    """Join the text of a YouTube 'runs' object ({"runs": [{"text": ...}]})."""
    if not isinstance(obj, dict):
        return ""
    if "simpleText" in obj:
        return obj["simpleText"]
    return "".join(r.get("text", "") for r in obj.get("runs", []))


def find_key(obj, key):
    """Depth-first search for the first value stored under `key`."""
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        children = obj.values()
    elif isinstance(obj, list):
        children = obj
    else:
        return None
    for child in children:
        found = find_key(child, key)
        if found is not None:
            return found
    return None


def walk(obj, key):
    """Yield every value stored under `key`, anywhere in the structure."""
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k == key:
                yield v
            yield from walk(v, key)
    elif isinstance(obj, list):
        for v in obj:
            yield from walk(v, key)


_logged = set()


def log_error(context=""):
    """Append the current exception to the error log (each distinct error once per run)."""
    text = traceback.format_exc()
    key = text.strip().splitlines()[-1] if text.strip() else context
    if key in _logged:
        return
    _logged.add(key)
    try:
        os.makedirs(CACHE, exist_ok=True)
        with open(ERROR_LOG, "a") as f:
            f.write(f"--- {time.strftime('%Y-%m-%d %H:%M:%S')} {context}\n{text}\n")
    except OSError:
        pass


